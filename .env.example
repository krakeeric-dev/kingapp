# Which Supabase project the app uses. Read only in lib/supabase-config.ts.
# Use the TEST project's values on a laptop (.env.local) and on Vercel Preview.
# Use the LIVE project's values only on Vercel Production.
# Anon (public) key only. Never put a service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
TELEPHONY_PROVIDER=mock
TELEPHONY_API_KEY=
TELEPHONY_WEBHOOK_SECRET=
NEXT_PUBLIC_TELEPHONY_WEBHOOK_CONFIGURED=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_SECRET=

THREE_CX_PBX_URL=
THREE_CX_CLIENT_ID=
THREE_CX_CLIENT_SECRET=
THREE_CX_WEBHOOK_SECRET=

ASTERISK_HOST=
ASTERISK_AMI_USERNAME=
ASTERISK_AMI_PASSWORD=
ASTERISK_WEBHOOK_SECRET=
